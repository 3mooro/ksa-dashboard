---
import { LayoutDashboard, Users, BookOpen, LogOut, Bell, Search, Settings, Menu, MessageSquare } from 'lucide-astro';
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<title>{title} | لوحة تحكم أكاديمية KSA</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
	<style>body { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-slate-50 flex h-[100dvh] overflow-hidden text-slate-800 relative">
	
	<!-- Overlay for mobile -->
	<div id="sidebar-backdrop" onclick="document.getElementById('sidebar').classList.add('translate-x-full'); this.classList.add('hidden');" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-10 hidden md:hidden transition-opacity"></div>

	<!-- القائمة الجانبية (Sidebar) -->
	<aside id="sidebar" class="w-72 bg-slate-950 text-slate-300 flex flex-col shadow-2xl z-20 fixed inset-y-0 right-0 transform translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out">
		<div class="h-20 flex items-center px-8 border-b border-slate-800/50">
			<div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-xl ml-3 shadow-lg shadow-blue-600/20">K</div>
			<span class="text-2xl font-black text-white tracking-tight">أكاديمية KSA</span>
		</div>
		
		<nav class="flex-1 px-4 py-8 space-y-2 overflow-y-auto">
			<p class="px-4 text-xs font-bold text-slate-500 uppercase tracking-wider mb-4">لوحة القيادة</p>
			
			<a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<LayoutDashboard class="w-5 h-5" /> <span>نظرة عامة</span>
			</a>
			<a href="/courses" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<BookOpen class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>إدارة الكورسات</span>
			</a>
			<a href="/blog" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<BookOpen class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>إدارة المقالات</span>
			</a>
			<a href="/students" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<Users class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>الطلاب المسجلين</span>
			</a>
			<a href="/chats" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<MessageSquare class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>مراقبة المحادثات</span>
			</a>
			<a href="/requests" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<Bell class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>طلبات التسجيل</span>
			</a>
			<a href="/teachers" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<Users class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>إدارة المعلمين</span>
			</a>
			<a href="/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-bold group border-r-4 border-transparent hover:border-slate-500">
				<Settings class="w-5 h-5 group-hover:text-blue-400 transition-colors" /> <span>إعدادات الموقع</span>
			</a>
		</nav>

		<div class="p-4 border-t border-slate-800/50">
			<form method="POST" action="/api/logout">
				<button type="submit" class="flex items-center gap-3 px-4 py-3 w-full rounded-xl text-slate-400 hover:bg-red-500/10 hover:text-red-400 transition-all font-bold">
					<LogOut class="w-5 h-5" /> <span>تسجيل خروج</span>
				</button>
			</form>
		</div>
	</aside>

	<!-- المحتوى الرئيسي (Main Content) -->
	<main class="flex-1 flex flex-col h-[100dvh] overflow-hidden relative">
		<!-- شريط التنقل العلوي -->
		<header class="h-20 bg-white/80 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-4 md:px-8 sticky top-0 z-10 w-full">
			<div class="flex items-center gap-4 flex-1 md:flex-none">
				<button id="mobile-menu-btn" onclick="document.getElementById('sidebar').classList.remove('translate-x-full'); document.getElementById('sidebar-backdrop').classList.remove('hidden');" class="p-2 -mr-2 text-slate-500 hover:bg-slate-100 rounded-lg md:hidden transition-colors">
					<Menu class="w-6 h-6" />
				</button>
				<div class="relative w-full max-w-[200px] md:max-w-none md:w-96 group hidden sm:block">
					<Search class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 group-focus-within:text-blue-600 transition-colors" />
					<input type="text" placeholder="بحث سريع عن طالب أو كورس..." class="w-full bg-slate-100 border-none rounded-full py-2.5 pr-10 pl-4 text-sm font-bold focus:ring-2 focus:ring-blue-500/20 focus:bg-white outline-none transition-all shadow-inner" />
				</div>
			</div>
			
			<div class="flex items-center gap-4 md:gap-6">
				<button class="relative text-slate-400 hover:text-blue-600 transition-colors">
					<Bell class="w-6 h-6" />
					<span class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-white"></span>
				</button>
				<div class="w-px h-8 bg-slate-200 hidden md:block"></div>
				<div class="flex items-center gap-3 cursor-pointer">
					<div class="text-left hidden md:block">
						<p class="text-sm font-black text-slate-800">المدير العام</p>
						<p class="text-xs font-bold text-slate-500">Omar Admin</p>
					</div>
					<img src="https://i.pravatar.cc/150?u=admin" class="w-10 h-10 rounded-full border-2 border-slate-200" alt="Admin" />
				</div>
			</div>
		</header>
		
		<!-- منطقة العمل (Page Content) -->
		<div class="flex-1 overflow-x-hidden overflow-y-auto p-4 md:p-8 w-full">
			<slot />
		</div>
	</main>

</body>
</html>
