					<Sparkles class="w-6 h-6" />
				</div>
				<div>
					<h3 class="text-2xl font-black text-slate-800">تحديد حصة تجريبية</h3>
					<p class="text-xs text-slate-500 font-bold mt-0.5">دون الحاجة لإنشاء طالب مسبقاً في النظام</p>
				</div>
			</div>
			
			<form method="POST" action="/api/trial-sessions/create" class="space-y-4">
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">اسم الطالب <span class="text-red-500">*</span></label>
					<input type="text" name="student_name" required placeholder="مثال: عبد العزيز فهد" class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800" />
				</div>

				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">رقم الهاتف / الواتساب</label>
					<input type="tel" name="student_phone" placeholder="05xxxxxxxx" class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800 text-left" dir="ltr" />
				</div>

				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">المعلم والمادة <span class="text-red-500">*</span></label>
					<select name="teacher_id" id="trial-teacher-select" required class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800">
						<option value="">اختر المعلم...</option>
						{teachersList.map((t: any) => (
							<option value={t.id} data-price={t.session_price || 0}>{t.name} ({t.subject})</option>
						))}
					</select>
				</div>

				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">تاريخ ووقت الحصة (بتوقيت السعودية) <span class="text-red-500">*</span></label>
					<input type="datetime-local" name="session_datetime" required class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800 text-left" dir="ltr" />
					<span class="text-[11px] text-slate-400 font-bold block mt-1">سيتم عرض الموعد في الصفحة الرئيسية بتوقيت مصر تلقائياً.</span>
				</div>

				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">مستحقات المعلم عن الحصة (ريال)</label>
					<input type="number" name="teacher_price" id="trial-teacher-price" value="0" min="0" step="any" required class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800 text-left" dir="ltr" />
					<span class="text-[11px] text-slate-400 font-bold block mt-1">يُضاف لرصيد المعلم عند الضغط على "إتمام الحصة". يمكنك تغييره أو جعله 0 إذا كانت بدون أجر.</span>
				</div>

				<div>
					<label class="block text-sm font-bold text-slate-700 mb-1">المرحلة الدراسية / ملاحظات إضافية</label>
					<input type="text" name="notes" placeholder="مثال: أول ثانوي - تجربة تأسيس قدرات" class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all font-bold text-slate-800" />
