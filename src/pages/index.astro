---
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Users, MousePointerClick, Globe, BookOpen, GraduationCap, MessagesSquare, Presentation } from 'lucide-astro';
import { env } from 'cloudflare:workers';

const session = Astro.cookies.get('admin_session');
if (!session) {
	return Astro.redirect('/login');
}

let studentsCount = 0;
let whatsappClicks = 0;
let globalVisits = 0;
let totalArticleViews = 0;
let coursesCount = 0;
let leadsCount = 0;
let teachersCount = 0;

try {
	const db = env.DB;
	if (db) {
		const result = await db.prepare("SELECT COUNT(*) as count FROM student_accounts").first();
		if (result) studentsCount = result.count as number;

		const statsResult = await db.prepare("SELECT total_visits, whatsapp_clicks FROM site_stats WHERE id = 'global'").first();
		if (statsResult) {
			globalVisits = statsResult.total_visits as number;
			whatsappClicks = statsResult.whatsapp_clicks as number;
		}

		const viewsResult = await db.prepare("SELECT SUM(views) as total_views FROM blog").first();
		if (viewsResult && viewsResult.total_views) totalArticleViews = viewsResult.total_views as number;
		
		const coursesResult = await db.prepare("SELECT COUNT(*) as count FROM courses").first();
		if (coursesResult) coursesCount = coursesResult.count as number;
		
		const leadsResult = await db.prepare("SELECT COUNT(*) as count FROM leads").first();
		if (leadsResult) leadsCount = leadsResult.count as number;
		
		const teachersResult = await db.prepare("SELECT COUNT(*) as count FROM teachers").first();
		if (teachersResult) teachersCount = teachersResult.count as number;
	}
} catch (e) {
	console.error("Database connection error:", e);
}
---
<DashboardLayout title="نظرة عامة">
	<div class="mb-8">
		<h2 class="text-3xl font-black text-slate-800">إحصائيات المنصة</h2>
		<p class="text-slate-500 font-bold mt-1">إليك ملخص شامل لأداء منصتك، وتحديثات حية ومباشرة للأرقام.</p>
	</div>

	<!-- بطاقات الإحصائيات -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
		{[
			{ title: "الطلاب المسجلين", value: studentsCount, icon: Users, color: "text-blue-600", bg: "bg-blue-50" },
			{ title: "زيارات الموقع", value: globalVisits, icon: Globe, color: "text-orange-600", bg: "bg-orange-50" },
			{ title: "مشاهدات المقالات", value: totalArticleViews, icon: BookOpen, color: "text-purple-600", bg: "bg-purple-50" },
			{ title: "نقرات الواتساب", value: whatsappClicks, icon: MousePointerClick, color: "text-green-600", bg: "bg-green-50" },
			{ title: "طلبات التسجيل (Leads)", value: leadsCount, icon: MessagesSquare, color: "text-pink-600", bg: "bg-pink-50" },
			{ title: "إجمالي الكورسات", value: coursesCount, icon: Presentation, color: "text-indigo-600", bg: "bg-indigo-50" },
			{ title: "المعلمين", value: teachersCount, icon: GraduationCap, color: "text-teal-600", bg: "bg-teal-50" },
		].map(stat => (
			<div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow group">
				<div class="flex justify-between items-start mb-4">
					<div class={`p-4 rounded-2xl ${stat.bg} ${stat.color} group-hover:scale-110 transition-transform`}>
						<stat.icon class="w-6 h-6" />
					</div>
				</div>
				<div>
					<h3 class="text-3xl font-black text-slate-800 mb-1">{stat.value}</h3>
					<p class="text-slate-500 text-sm font-bold">{stat.title}</p>
				</div>
			</div>
		))}
	</div>

	<!-- Chart Section -->
	<div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-10">
		<div class="flex justify-between items-center mb-6">
			<h2 class="text-xl font-black text-slate-800">رسم بياني لزيارات الموقع</h2>
			<div class="flex gap-2 bg-slate-50 p-1 rounded-xl border border-slate-100">
				<button data-range="hour" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">اليوم (بالساعات)</button>
				<button data-range="week" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors bg-white shadow-sm text-blue-600 border border-slate-100">هذا الأسبوع (بالأيام)</button>
				<button data-range="month" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">هذا العام (بالشهور)</button>
				<button data-range="year" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">كل الوقت (بالسنين)</button>
			</div>
		</div>
		<div class="relative h-80 w-full">
			<canvas id="visitsChart"></canvas>
		</div>
	</div>

	<!-- جدول أحدث الطلبات -->
	<div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
		<div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
			<h2 class="text-lg font-black text-slate-800">إدارة الإحصائيات</h2>
		</div>
		<div class="p-12 text-center text-slate-400 font-bold flex flex-col items-center justify-center">
			<p>يتم تحديث هذه الأرقام والرسومات البيانية تلقائياً مع كل زيارة في الموقع الرئيسي.</p>
		</div>
	</div>

</DashboardLayout>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const ctx = document.getElementById('visitsChart').getContext('2d');
		let myChart = null;

		const loadChartData = async (range) => {
			try {
				const response = await fetch(`/api/chart-data?range=${range}`);
				const json = await response.json();
				const data = json.data || [];
				
				const labels = data.map(d => d.label);
				const counts = data.map(d => d.count);

				if (myChart) {
					myChart.destroy();
				}

				myChart = new Chart(ctx, {
					type: 'line',
					data: {
						labels: labels,
						datasets: [{
							label: 'عدد الزيارات',
							data: counts,
							borderColor: '#2563eb', // blue-600
							backgroundColor: 'rgba(37, 99, 235, 0.1)',
							borderWidth: 3,
							pointBackgroundColor: '#ffffff',
							pointBorderColor: '#2563eb',
							pointBorderWidth: 2,
							pointRadius: 4,
							pointHoverRadius: 6,
							fill: true,
							tension: 0.4
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: false
							},
							tooltip: {
								titleFont: { family: 'Tajawal', size: 14 },
								bodyFont: { family: 'Tajawal', size: 14, weight: 'bold' },
								padding: 12,
								backgroundColor: 'rgba(15, 23, 42, 0.9)',
								cornerRadius: 8,
								displayColors: false
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								grid: {
									color: '#f1f5f9',
									drawBorder: false
								},
								ticks: {
									font: { family: 'Tajawal', weight: 'bold' },
									color: '#64748b'
								}
							},
							x: {
								grid: {
									display: false,
									drawBorder: false
								},
								ticks: {
									font: { family: 'Tajawal', weight: 'bold' },
									color: '#64748b'
								}
							}
						}
					}
				});
			} catch (err) {
				console.error("Error loading chart data:", err);
			}
		};

		// Initial load
		loadChartData('week');

		// Handle tabs
		const tabs = document.querySelectorAll('.chart-tab');
		tabs.forEach(tab => {
			tab.addEventListener('click', (e) => {
				// Reset styles
				tabs.forEach(t => {
					t.classList.remove('bg-white', 'shadow-sm', 'text-blue-600', 'border', 'border-slate-100');
					t.classList.add('text-slate-500');
				});
				
				// Active style
				e.target.classList.remove('text-slate-500');
				e.target.classList.add('bg-white', 'shadow-sm', 'text-blue-600', 'border', 'border-slate-100');
				
				// Load new data
				const range = e.target.getAttribute('data-range');
				loadChartData(range);
			});
		});
	});
</script>
