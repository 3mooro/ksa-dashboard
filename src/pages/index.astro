		</div>
	</div>

</DashboardLayout>

<!-- Chart.js and scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script is:inline>
	// Open convert modal helper
	window.openConvertModal = function(trialId, studentName, studentPhone) {
		const modal = document.getElementById('convert-trial-modal');
		const idInput = document.getElementById('convert-trial-id');
		const nameInput = document.getElementById('convert-student-name');
		if (modal && idInput && nameInput) {
			idInput.value = trialId;
			nameInput.value = studentName + (studentPhone ? ` (${studentPhone})` : '');
			modal.classList.remove('hidden');
		}
	};

	document.addEventListener('DOMContentLoaded', () => {
		// Auto-populate price when teacher is selected
		const teacherSelect = document.getElementById('trial-teacher-select');
		const priceInput = document.getElementById('trial-teacher-price');
		if (teacherSelect && priceInput) {
			teacherSelect.addEventListener('change', () => {
				const selectedOption = teacherSelect.options[teacherSelect.selectedIndex];
				const price = selectedOption ? selectedOption.getAttribute('data-price') : 0;
				if (price !== null && price !== undefined) {
					priceInput.value = price;
				}
			});
		}

		// Visits Chart
		const chartEl = document.getElementById('visitsChart');
		if (chartEl) {
			const ctx = chartEl.getContext('2d');
			let myChart = null;

			const loadChartData = async (range) => {
				try {
					const response = await fetch(`/api/chart-data?range=${range}`);
					const json = await response.json();
					const data = json.data || [];
					
					const labels = data.map(d => d.label);
					const counts = data.map(d => d.count);

					if (myChart) {
						myChart.destroy();
					}

					myChart = new Chart(ctx, {
						type: 'line',
						data: {
							labels: labels,
							datasets: [{
								label: 'عدد الزيارات',
								data: counts,
								borderColor: '#2563eb', // blue-600
								backgroundColor: 'rgba(37, 99, 235, 0.1)',
								borderWidth: 3,
								pointBackgroundColor: '#ffffff',
								pointBorderColor: '#2563eb',
								pointBorderWidth: 2,
								pointRadius: 4,
								pointHoverRadius: 6,
								fill: true,
								tension: 0.4
							}]
						},
						options: {
							responsive: true,
							maintainAspectRatio: false,
							plugins: {
								legend: {
									display: false
								},
								tooltip: {
									titleFont: { family: 'Tajawal', size: 14 },
									bodyFont: { family: 'Tajawal', size: 14, weight: 'bold' },
									padding: 12,
									backgroundColor: 'rgba(15, 23, 42, 0.9)',
									cornerRadius: 8,
									displayColors: false
								}
							},
							scales: {
								y: {
									beginAtZero: true,
									grid: {
										color: '#f1f5f9',
										drawBorder: false
									},
									ticks: {
										font: { family: 'Tajawal', weight: 'bold' },
										color: '#64748b'
									}
								},
								x: {
									grid: {
										display: false,
										drawBorder: false
									},
									ticks: {
										font: { family: 'Tajawal', weight: 'bold' },
										color: '#64748b'
									}
								}
							}
						}
					});
				} catch (err) {
					console.error("Error loading chart data:", err);
				}
			};

			// Initial load
			loadChartData('week');

			// Handle tabs
			const tabs = document.querySelectorAll('.chart-tab');
			tabs.forEach(tab => {
				tab.addEventListener('click', (e) => {
					// Reset styles
					tabs.forEach(t => {
						t.classList.remove('bg-white', 'shadow-sm', 'text-blue-600', 'border', 'border-slate-100');
						t.classList.add('text-slate-500');
					});
					
					// Active style
					e.target.classList.remove('text-slate-500');
					e.target.classList.add('bg-white', 'shadow-sm', 'text-blue-600', 'border', 'border-slate-100');
					
					// Load new data
					const range = e.target.getAttribute('data-range');
					loadChartData(range);
				});
			});
		}
	});
</script>
