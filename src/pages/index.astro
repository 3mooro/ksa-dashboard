---
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { 
	Users, MousePointerClick, Globe, BookOpen, MessagesSquare, Presentation, 
	GraduationCap, CalendarDays, Sparkles, Plus, CheckCircle2, Trash2, UserPlus, Clock, Phone
} from 'lucide-astro';
import { env } from 'cloudflare:workers';

const session = Astro.cookies.get('admin_session');
if (!session) {
	return Astro.redirect('/login');
}

const success = Astro.url.searchParams.get('success');

let studentsCount = 0;
let whatsappClicks = 0;
let globalVisits = 0;
let totalArticleViews = 0;
let coursesCount = 0;
let leadsCount = 0;
let teachersCount = 0;
let todaySessions: any[] = [];
let upcomingTrials: any[] = [];
let teachersList: any[] = [];

const db = env.DB;
if (db) {
	const safeQuery = async (query: string, params: any[] = []) => {
		try {
			return await db.prepare(query).bind(...params).first();
		} catch (e) {
			return null;
		}
	};

	// Auto-create trial_sessions table if not exists
	try {
		await db.prepare(`
			CREATE TABLE IF NOT EXISTS trial_sessions (
				id INTEGER PRIMARY KEY AUTOINCREMENT,
				student_name TEXT NOT NULL,
				student_phone TEXT,
				teacher_id INTEGER NOT NULL,
				session_datetime DATETIME NOT NULL,
				notes TEXT,
				teacher_price REAL DEFAULT 0,
				status TEXT DEFAULT 'scheduled',
				created_at DATETIME DEFAULT CURRENT_TIMESTAMP
			)
		`).run();
	} catch (e) {}

	const result = await safeQuery("SELECT COUNT(*) as count FROM student_accounts");
	if (result) studentsCount += result.count as number;
	
	const manualStudents = await safeQuery("SELECT COUNT(*) as count FROM students");
	if (manualStudents) studentsCount += manualStudents.count as number;

	const statsResult = await safeQuery("SELECT total_visits, whatsapp_clicks FROM site_stats WHERE id = 'global'");
	if (statsResult) {
		globalVisits = statsResult.total_visits as number;
		whatsappClicks = statsResult.whatsapp_clicks as number;
	}

	const viewsResult = await safeQuery("SELECT SUM(views) as total_views FROM blog");
	if (viewsResult && viewsResult.total_views) totalArticleViews = viewsResult.total_views as number;
	
	const coursesResult = await safeQuery("SELECT COUNT(*) as count FROM courses");
	if (coursesResult) coursesCount = coursesResult.count as number;
	
	const leadsResult = await safeQuery("SELECT COUNT(*) as count FROM leads");
	if (leadsResult) leadsCount = leadsResult.count as number;
	
	const teachersResult = await safeQuery("SELECT COUNT(*) as count FROM teachers");
	if (teachersResult) teachersCount = teachersResult.count as number;

	// Fetch active teachers for the trial session modal dropdown
	try {
		const tListRes = await db.prepare("SELECT id, name, subject, session_price FROM teachers WHERE status = 'active' ORDER BY name ASC").all();
		teachersList = tListRes.results || [];
	} catch (e) {}

	// Today's scheduled sessions (regular scheduled, weekly recurring, and trial sessions)
	try {
		const ksaDateStr = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Riyadh', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
		const [month, day, year] = ksaDateStr.split('/');
		const todayKSA = `${year}-${month}-${day}`;
		
		const ksaDayOfWeek = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Riyadh' })).getDay();

		// Clean up any orphaned schedules where student and teacher are unlinked
		try {
			await db.prepare(`
				DELETE FROM weekly_schedule 
				WHERE NOT EXISTS (
					SELECT 1 FROM student_teacher st 
					WHERE st.student_id = weekly_schedule.student_id 
					AND st.teacher_id = weekly_schedule.teacher_id
				)
			`).run();

			await db.prepare(`
				DELETE FROM session_schedule 
				WHERE NOT EXISTS (
					SELECT 1 FROM student_teacher st 
					WHERE st.student_id = session_schedule.student_id 
					AND st.teacher_id = session_schedule.teacher_id
				)
			`).run();
		} catch (cleanupErr) {
			// ignore cleanup error
		}

		const scheduleRes = await db.prepare(`
			SELECT ss.id, ss.student_id, ss.teacher_id, ss.session_datetime, ss.status, s.name as student_name, t.name as teacher_name, t.subject, 0 as is_trial, s.phone as student_phone, NULL as notes
			FROM session_schedule ss
			JOIN student_teacher st ON ss.student_id = st.student_id AND ss.teacher_id = st.teacher_id
			JOIN students s ON ss.student_id = s.id
			JOIN teachers t ON ss.teacher_id = t.id
			WHERE date(ss.session_datetime) = ? 
			AND ss.status = 'scheduled'
			
			UNION ALL
			
			SELECT NULL as id, ws.student_id, ws.teacher_id, ? || 'T' || ws.time_of_day as session_datetime, 'scheduled' as status, s.name as student_name, t.name as teacher_name, t.subject, 0 as is_trial, s.phone as student_phone, NULL as notes
			FROM weekly_schedule ws
			JOIN student_teacher st ON ws.student_id = st.student_id AND ws.teacher_id = st.teacher_id
			JOIN students s ON ws.student_id = s.id
			JOIN teachers t ON ws.teacher_id = t.id
			WHERE ws.day_of_week = ?
			
			UNION ALL

			SELECT ts.id, NULL as student_id, ts.teacher_id, ts.session_datetime, ts.status, ts.student_name, t.name as teacher_name, t.subject, 1 as is_trial, ts.student_phone, ts.notes
			FROM trial_sessions ts
			JOIN teachers t ON ts.teacher_id = t.id
			WHERE date(ts.session_datetime) = ?
			AND ts.status = 'scheduled'
			
			ORDER BY session_datetime ASC
		`).bind(todayKSA, todayKSA, ksaDayOfWeek, todayKSA).all();
		todaySessions = scheduleRes.results || [];

		// Fetch upcoming trial sessions scheduled for future dates
		try {
			const upRes = await db.prepare(`
				SELECT ts.*, t.name as teacher_name, t.subject
				FROM trial_sessions ts
				JOIN teachers t ON ts.teacher_id = t.id
				WHERE date(ts.session_datetime) > ?
				AND ts.status = 'scheduled'
				ORDER BY ts.session_datetime ASC
				LIMIT 20
			`).bind(todayKSA).all();
			upcomingTrials = upRes.results || [];
		} catch (e) {}

	} catch(e) {
		console.error("Schedule error:", e);
	}
}
---

<DashboardLayout title="نظرة عامة">
	
	<!-- Alert notifications -->
	{success === 'trial_scheduled' && (
		<div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-2xl font-bold flex items-center justify-between shadow-sm animate-fade-in">
			<div class="flex items-center gap-2">
				<CheckCircle2 class="w-5 h-5 text-green-600" />
				<span>تم تحديد موعد الحصة التجريبية بنجاح وإضافتها للجدول!</span>
			</div>
			<a href="/" class="text-xs text-green-700 hover:underline">إغلاق</a>
		</div>
	)}

	{success === 'trial_completed' && (
		<div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-2xl font-bold flex items-center justify-between shadow-sm animate-fade-in">
			<div class="flex items-center gap-2">
				<CheckCircle2 class="w-5 h-5 text-green-600" />
				<span>تم تسجيل إتمام الحصة التجريبية وإضافة مستحقات المعلم بنجاح!</span>
			</div>
			<a href="/" class="text-xs text-green-700 hover:underline">إغلاق</a>
		</div>
	)}

	{success === 'trial_cancelled' && (
		<div class="mb-6 p-4 bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl font-bold flex items-center justify-between shadow-sm animate-fade-in">
			<div class="flex items-center gap-2">
				<CheckCircle2 class="w-5 h-5 text-amber-600" />
				<span>تم إلغاء الحصة التجريبية بنجاح.</span>
			</div>
			<a href="/" class="text-xs text-amber-700 hover:underline">إغلاق</a>
		</div>
	)}

	<div class="mb-8">
		<h2 class="text-3xl font-black text-slate-800">إحصائيات الأكاديمية</h2>
		<p class="text-slate-500 font-bold mt-1">مرحباً بك، إليك ملخص لأداء المنصة اليوم (أرقام حقيقية ومباشرة).</p>
	</div>

	<!-- بطاقات الإحصائيات -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
		{[
			{ title: "الطلاب المسجلين", value: studentsCount, icon: Users, color: "text-blue-600", bg: "bg-blue-50" },
			{ title: "زيارات الموقع", value: globalVisits, icon: Globe, color: "text-orange-600", bg: "bg-orange-50" },
			{ title: "مشاهدات المقالات", value: totalArticleViews, icon: BookOpen, color: "text-purple-600", bg: "bg-purple-50" },
			{ title: "نقرات الواتساب", value: whatsappClicks, icon: MousePointerClick, color: "text-green-600", bg: "bg-green-50" },
			{ title: "طلبات التسجيل (Leads)", value: leadsCount, icon: MessagesSquare, color: "text-pink-600", bg: "bg-pink-50" },
			{ title: "إجمالي الكورسات", value: coursesCount, icon: Presentation, color: "text-indigo-600", bg: "bg-indigo-50" },
			{ title: "المعلمين", value: teachersCount, icon: GraduationCap, color: "text-teal-600", bg: "bg-teal-50" },
		].map(stat => (
			<div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow group">
				<div class="flex justify-between items-start mb-4">
					<div class={`p-4 rounded-2xl ${stat.bg} ${stat.color} group-hover:scale-110 transition-transform`}>
						<stat.icon class="w-6 h-6" />
					</div>
				</div>
				<div>
					<h3 class="text-3xl font-black text-slate-800 mb-1">{stat.value}</h3>
					<p class="text-slate-500 text-sm font-bold">{stat.title}</p>
				</div>
			</div>
		))}
	</div>

	<!-- Chart Section -->
	<div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-10">
		<div class="flex justify-between items-center mb-6">
			<h2 class="text-xl font-black text-slate-800">رسم بياني لزيارات الموقع</h2>
			<div class="flex gap-2 bg-slate-50 p-1 rounded-xl border border-slate-100">
				<button data-range="hour" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">اليوم (بالساعات)</button>
				<button data-range="week" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors bg-white shadow-sm text-blue-600 border border-slate-100">هذا الأسبوع (بالأيام)</button>
				<button data-range="month" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">هذا العام (بالشهور)</button>
				<button data-range="year" class="chart-tab px-4 py-2 text-sm font-bold rounded-lg transition-colors text-slate-500 hover:text-slate-800">كل الوقت (بالسنين)</button>
			</div>
		</div>
		<div class="relative h-80 w-full">
			<canvas id="visitsChart"></canvas>
		</div>
	</div>

	<!-- جدول مواعيد اليوم -->
	<div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden mb-10">
		<div class="p-6 border-b border-slate-100 flex flex-wrap justify-between items-center bg-slate-50/50 gap-4">
			<h2 class="text-lg font-black text-slate-800 flex items-center gap-2">
				<CalendarDays class="w-5 h-5 text-blue-600" /> حصص ومواعيد اليوم
			</h2>
			<button 
				type="button" 
				onclick="document.getElementById('trial-session-modal').classList.remove('hidden')" 
				class="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-4 py-2.5 rounded-xl font-black text-sm shadow-md shadow-orange-500/20 hover:scale-[1.02] active:scale-95 transition-all cursor-pointer"
			>
				<Sparkles class="w-4 h-4" /> تحديد حصة تجريبية
			</button>
		</div>
		
		{todaySessions.length === 0 ? (
			<div class="p-12 text-center text-slate-400 font-bold flex flex-col items-center justify-center">
				<p>لا يوجد حصص مجدولة لهذا اليوم.</p>
				<button 
					type="button" 
					onclick="document.getElementById('trial-session-modal').classList.remove('hidden')" 
					class="mt-3 text-amber-600 hover:text-amber-700 text-sm font-black flex items-center gap-1"
				>
					<Sparkles class="w-4 h-4" /> تحديد حصة تجريبية الآن
				</button>
			</div>
		) : (
			<div class="overflow-x-auto">
				<table class="w-full text-right border-collapse">
					<thead>
						<tr class="bg-muted/50 text-muted-foreground border-b text-sm font-bold">
							<th class="p-4">الوقت (بتوقيت مصر)</th>
							<th class="p-4">الطالب</th>
							<th class="p-4">المعلم (المادة)</th>
							<th class="p-4">الإجراء</th>
						</tr>
					</thead>
					<tbody class="divide-y text-sm">
						{todaySessions.map(session => (
							<tr class={`transition-colors ${session.is_trial ? 'bg-amber-50/40 hover:bg-amber-50/70' : 'hover:bg-slate-50'}`}>
								<td class="p-4 font-bold text-slate-600" dir="ltr">
									{new Intl.DateTimeFormat('ar-EG', {
										timeZone: 'Africa/Cairo',
										hour: 'numeric',
										minute: 'numeric',
										hour12: true
									}).format(new Date(session.session_datetime.includes('+') || session.session_datetime.includes('Z') ? session.session_datetime : session.session_datetime + '+03:00'))}
								</td>
								
								<td class="p-4">
									{session.is_trial ? (
										<div>
											<div class="flex items-center gap-2 flex-wrap">
												<span class="font-black text-slate-800 text-base">{session.student_name}</span>
												<span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-0.5 rounded-full font-black border border-amber-200 flex items-center gap-1">
													<Sparkles class="w-3 h-3 text-amber-600 inline" /> حصة تجريبية
												</span>
											</div>
											{session.student_phone && (
												<div class="flex items-center gap-2 mt-1">
													<span class="text-xs text-slate-500 font-bold" dir="ltr">{session.student_phone}</span>
													<a 
														href={`https://wa.me/${session.student_phone.replace(/[^0-9]/g, '')}`} 
														target="_blank" 
														class="text-green-600 hover:text-green-700 font-bold text-xs inline-flex items-center gap-0.5"
														title="مراسلة عبر واتساب"
													>
														<Phone class="w-3 h-3" /> واتساب
													</a>
												</div>
											)}
											{session.notes && (
												<span class="text-xs text-slate-500 block mt-1">{session.notes}</span>
											)}
										</div>
									) : (
										<div class="flex items-center gap-2">
											<span class="font-black text-slate-800 text-base">{session.student_name}</span>
											<a href={`/students/${session.student_id}`} class="text-blue-500 hover:text-blue-700 text-xs font-bold" title="عرض ملف الطالب">
												(ملف الطالب)
											</a>
										</div>
									)}
								</td>

								<td class="p-4 font-bold text-slate-600">
									{session.teacher_name} <span class="text-xs bg-slate-100 px-2 py-1 rounded-full ml-1 font-bold">{session.subject}</span>
								</td>

								<td class="p-4">
									{session.is_trial ? (
										<div class="flex items-center gap-2 flex-wrap">
											<form method="POST" action="/api/trial-sessions/complete" class="inline" onsubmit="return confirm('هل تريد تأكيد إتمام الحصة التجريبية واحتساب مستحقات المعلم؟');">
												<input type="hidden" name="id" value={session.id} />
												<button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-xl font-bold text-xs transition-colors flex items-center gap-1 shadow-sm">
													<CheckCircle2 class="w-3.5 h-3.5" /> إتمام الحصة
												</button>
											</form>

											<button 
												type="button" 
												onclick={`openConvertModal(${session.id}, '${session.student_name.replace(/'/g, "\\'")}', '${(session.student_phone || '').replace(/'/g, "\\'")}')`}
												class="bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-1.5 rounded-xl font-bold text-xs transition-colors flex items-center gap-1"
												title="تسجيله كطالب رسمي في النظام"
											>
												<UserPlus class="w-3.5 h-3.5" /> تحويل لطالب رسمي
											</button>
											
											<form method="POST" action="/api/trial-sessions/delete" class="inline" onsubmit="return confirm('هل أنت متأكد من إلغاء وحذف هذه الحصة التجريبية؟');">
												<input type="hidden" name="id" value={session.id} />
												<button type="submit" class="text-red-400 hover:text-red-600 bg-red-50 hover:bg-red-100 p-1.5 rounded-xl transition-colors" title="إلغاء الحصة">
													<Trash2 class="w-4 h-4" />
												</button>
											</form>
										</div>
									) : (
										<form method="POST" action="/api/students/log-session" class="inline">
											<input type="hidden" name="schedule_id" value={session.id} />
											<input type="hidden" name="student_id" value={session.student_id} />
											<input type="hidden" name="teacher_id" value={session.teacher_id} />
											<button type="submit" class="bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-1.5 rounded-xl font-bold text-xs transition-colors">
												تسجيل حضور
											</button>
										</form>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)}
	</div>

	<!-- الحصص التجريبية القادمة (إن وجدت لأيام قادمة) -->
	{upcomingTrials.length > 0 && (
		<div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden mb-10">
			<div class="p-6 border-b border-slate-100 flex justify-between items-center bg-amber-50/30">
				<h2 class="text-lg font-black text-slate-800 flex items-center gap-2">
					<Sparkles class="w-5 h-5 text-amber-500" /> الحصص التجريبية القادمة للأيام القادمة ({upcomingTrials.length})
				</h2>
			</div>
			
			<div class="overflow-x-auto">
				<table class="w-full text-right border-collapse">
					<thead>
						<tr class="bg-muted/50 text-muted-foreground border-b text-sm font-bold">
							<th class="p-4">الموعد (بتوقيت مصر)</th>
							<th class="p-4">اسم الطالب</th>
							<th class="p-4">المعلم (المادة)</th>
							<th class="p-4">مستحقات المعلم</th>
							<th class="p-4">الإجراء</th>
						</tr>
					</thead>
					<tbody class="divide-y text-sm">
						{upcomingTrials.map(trial => (
							<tr class="hover:bg-amber-50/30 transition-colors">
								<td class="p-4 font-bold text-slate-600" dir="ltr">
									{new Intl.DateTimeFormat('ar-EG', {
										timeZone: 'Africa/Cairo',
										year: 'numeric',
										month: 'short',
										day: 'numeric',
										hour: 'numeric',
										minute: 'numeric',
										hour12: true
									}).format(new Date(trial.session_datetime.includes('+') || trial.session_datetime.includes('Z') ? trial.session_datetime : trial.session_datetime + '+03:00'))}
								</td>
								
								<td class="p-4">
									<div class="font-black text-slate-800 text-base">{trial.student_name}</div>
									{trial.student_phone && (
										<div class="flex items-center gap-2 mt-0.5">
											<span class="text-xs text-slate-500 font-bold" dir="ltr">{trial.student_phone}</span>
											<a href={`https://wa.me/${trial.student_phone.replace(/[^0-9]/g, '')}`} target="_blank" class="text-green-600 text-xs font-bold">واتساب</a>
										</div>
									)}
									{trial.notes && <span class="text-xs text-slate-500 block mt-1">{trial.notes}</span>}
								</td>

								<td class="p-4 font-bold text-slate-600">
									{trial.teacher_name} <span class="text-xs bg-slate-100 px-2 py-1 rounded-full ml-1 font-bold">{trial.subject}</span>
								</td>

								<td class="p-4 font-black text-slate-700">
									{trial.teacher_price ? `${trial.teacher_price} ريال` : 'مجانية (0 ريال)'}
								</td>

								<td class="p-4">
									<div class="flex items-center gap-2">
										<button 
											type="button" 
											onclick={`openConvertModal(${trial.id}, '${trial.student_name.replace(/'/g, "\\'")}', '${(trial.student_phone || '').replace(/'/g, "\\'")}')`}
											class="bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-1.5 rounded-xl font-bold text-xs transition-colors flex items-center gap-1"
										>
											<UserPlus class="w-3.5 h-3.5" /> تحويل لطالب
										</button>
										
										<form method="POST" action="/api/trial-sessions/delete" class="inline" onsubmit="return confirm('هل تريد إلغاء هذه الحصة التجريبية؟');">
											<input type="hidden" name="id" value={trial.id} />
											<button type="submit" class="text-red-400 hover:text-red-600 bg-red-50 hover:bg-red-100 p-1.5 rounded-xl transition-colors" title="إلغاء">
												<Trash2 class="w-4 h-4" />
											</button>
										</form>
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	)}

	<!-- Modal: تحديد حصة تجريبية -->
	<div id="trial-session-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center flex p-4">
		<div class="bg-white p-6 sm:p-8 rounded-3xl w-full max-w-lg shadow-2xl relative border border-slate-100 max-h-[90vh] overflow-y-auto">
			<button type="button" onclick="document.getElementById('trial-session-modal').classList.add('hidden')" class="absolute top-5 left-5 text-slate-400 hover:text-slate-600 cursor-pointer">
