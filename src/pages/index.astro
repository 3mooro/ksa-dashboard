	<!-- Modal: تحويل لطالب رسمي -->
	<div id="convert-trial-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center flex p-4">
		<div class="bg-white p-6 sm:p-8 rounded-3xl w-full max-w-md shadow-2xl relative border border-slate-100">
			<button type="button" onclick="document.getElementById('convert-trial-modal').classList.add('hidden')" class="absolute top-5 left-5 text-slate-400 hover:text-slate-600 cursor-pointer">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
