---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { Users, Plus, Phone, GraduationCap, ChevronLeft } from 'lucide-astro';

const db = env.DB;
let students: any[] = [];

if (db) {
  try {
    const res = await db.prepare(`SELECT * FROM students ORDER BY id DESC`).all();
    students = res.results || [];
  } catch (e) {
    console.error(e);
  }
}
---

<DashboardLayout title="إدارة الطلاب">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-black text-slate-800 flex items-center gap-3">
      <Users class="w-8 h-8 text-blue-600" /> إدارة الطلاب
    </h1>
    <button onclick="document.getElementById('add-student-modal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-black transition-all flex items-center gap-2 shadow-lg shadow-blue-600/30 hover:scale-105">
      <Plus class="w-5 h-5" /> إضافة طالب يدوياً
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {students.length === 0 ? (
      <div class="col-span-full bg-white rounded-3xl p-12 text-center border border-slate-100 shadow-sm">
        <p class="text-slate-400 font-bold text-lg mb-4">لا يوجد طلاب مسجلين حتى الآن.</p>
        <button onclick="document.getElementById('add-student-modal').classList.remove('hidden')" class="text-blue-600 hover:text-blue-700 font-bold">أضف الطالب الأول</button>
      </div>
    ) : (
      students.map((student: any) => (
        <a href={`/students/${student.id}`} class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 hover:shadow-lg transition-all group block relative overflow-hidden hover:-translate-y-1">
          <div class="absolute top-0 right-0 w-2 h-full bg-blue-500 rounded-r-3xl"></div>
          <div class="flex justify-between items-start mb-4 pr-4">
            <div>
              <h3 class="text-xl font-black text-slate-800 group-hover:text-blue-600 transition-colors">{student.name}</h3>
              <div class="flex items-center gap-2 text-slate-500 mt-2 text-sm font-bold">
                <GraduationCap class="w-4 h-4" /> {student.grade || 'غير محدد'}
              </div>
            </div>
          </div>
          
          <div class="pr-4 space-y-3">
            <div class="flex items-center gap-2 text-slate-600 text-sm font-bold" dir="ltr">
              <Phone class="w-4 h-4" /> {student.phone || 'لا يوجد'}
            </div>
            
            <div class="flex items-center justify-between mt-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <span class="text-xs font-bold text-slate-500">الرصيد المتبقي</span>
              <span class={`font-black text-lg ${student.total_sessions > 0 ? 'text-green-600' : 'text-red-500'}`}>
                {student.total_sessions || 0} حصص
              </span>
            </div>
          </div>
          <div class="mt-4 pr-4 flex items-center justify-end text-blue-600 font-bold text-sm gap-1 group-hover:translate-x-[-5px] transition-transform">
            عرض الملف <ChevronLeft class="w-4 h-4" />
          </div>
        </a>
      ))
    )}
  </div>

  <!-- Add Student Modal -->
  <div id="add-student-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center flex">
    <div class="bg-white p-8 rounded-3xl w-full max-w-md shadow-2xl relative border border-slate-100">
      <button type="button" onclick="document.getElementById('add-student-modal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
      </button>
      <h3 class="text-2xl font-black mb-6 text-slate-800">إضافة طالب جديد</h3>
      
      <form method="POST" action="/api/students/manual-add" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">اسم الطالب</label>
          <input type="text" name="name" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold" />
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">الصف الدراسي</label>
          <select name="grade" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold">
            <option value="الابتدائي">المرحلة الابتدائية</option>
            <option value="المتوسط">المرحلة المتوسطة</option>
            <option value="الثانوي">المرحلة الثانوية</option>
            <option value="القدرات والتحصيلي">قدرات وتحصيلي</option>
            <option value="الجامعي">المرحلة الجامعية</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">رقم هاتف الطالب أو ولي الأمر</label>
          <input type="text" name="phone" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold text-left" dir="ltr" />
        </div>
        <button type="submit" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-black transition-all shadow-lg shadow-blue-600/30">
          حفظ الطالب
        </button>
      </form>
    </div>
  </div>
</DashboardLayout>
