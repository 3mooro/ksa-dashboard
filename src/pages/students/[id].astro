---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { User, Phone, GraduationCap, Link2, CreditCard, CalendarDays, CheckCircle2 } from 'lucide-astro';

const { id } = Astro.params;
const db = env.DB;

let student: any = null;
let teachers: any[] = [];
let assignedTeachers: any[] = [];
let sessions: any[] = [];
let payments: any[] = [];

if (db && id) {
  try {
    const studentRes = await db.prepare('SELECT * FROM students WHERE id = ?').bind(id).first();
    student = studentRes;

    const teachersRes = await db.prepare('SELECT id, name, subject FROM teachers').all();
    teachers = teachersRes.results || [];

    const assignedRes = await db.prepare(`
      SELECT st.id, t.id as teacher_id, t.name, t.subject, tp.price
      FROM student_teacher st
      JOIN teachers t ON st.teacher_id = t.id
      LEFT JOIN teacher_prices tp ON tp.teacher_id = t.id AND tp.grade = ?
      WHERE st.student_id = ?
    `).bind(student.grade, id).all();
    assignedTeachers = assignedRes.results || [];

    const sessionsRes = await db.prepare(`
      SELECT sl.*, t.name as teacher_name 
      FROM sessions_log sl
      JOIN teachers t ON sl.teacher_id = t.id
      WHERE sl.student_id = ?
      ORDER BY sl.session_date DESC LIMIT 20
    `).bind(id).all();
    sessions = sessionsRes.results || [];

    const paymentsRes = await db.prepare(`
      SELECT * FROM payments_log WHERE student_id = ? ORDER BY payment_date DESC LIMIT 10
    `).bind(id).all();
    payments = paymentsRes.results || [];
  } catch (e) {
    console.error(e);
  }
}

if (!student) {
  return Astro.redirect('/students');
}
---

<DashboardLayout title={`ملف الطالب - ${student.name}`}>
  <div class="flex items-center gap-4 mb-8">
    <a href="/students" class="text-slate-500 hover:text-slate-800 font-bold bg-slate-100 p-2 rounded-xl">عودة</a>
    <h1 class="text-3xl font-black text-slate-800">ملف الطالب</h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Student Info -->
    <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm col-span-1 h-fit">
      <div class="w-20 h-20 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4 mx-auto">
        <User class="w-10 h-10" />
      </div>
      <h2 class="text-2xl font-black text-center text-slate-800 mb-6">{student.name}</h2>
      
      <div class="space-y-4">
        <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl">
          <div class="flex gap-2 text-slate-600 font-bold"><GraduationCap class="w-5 h-5"/> الصف</div>
          <span class="font-black text-slate-800">{student.grade}</span>
        </div>
        <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl">
          <div class="flex gap-2 text-slate-600 font-bold"><Phone class="w-5 h-5"/> الهاتف</div>
          <span class="font-black text-slate-800" dir="ltr">{student.phone}</span>
        </div>
        <div class="flex justify-between items-center bg-blue-50 p-4 rounded-xl border border-blue-100">
          <div class="font-black text-blue-800">الرصيد الحالي</div>
          <span class={`font-black text-xl ${student.total_sessions > 0 ? 'text-green-600' : 'text-red-500'}`}>{student.total_sessions || 0} حصة</span>
        </div>
      </div>
    </div>

    <div class="col-span-1 lg:col-span-2 space-y-6">
      
      <!-- Actions Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Add Payment -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm relative overflow-hidden group hover:border-green-300 transition-colors">
          <div class="absolute -right-4 -top-4 w-16 h-16 bg-green-50 rounded-full flex items-center justify-center opacity-50 group-hover:scale-150 transition-transform">
            <CreditCard class="w-6 h-6 text-green-500" />
          </div>
          <h3 class="text-lg font-black text-slate-800 mb-4 relative z-10">إضافة دفعة مالية (شحن حصص)</h3>
          <form method="POST" action="/api/students/add-payment" class="space-y-3 relative z-10">
            <input type="hidden" name="student_id" value={student.id} />
            <input type="number" name="amount" placeholder="المبلغ (ريال)" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold focus:ring-2 focus:ring-green-500" />
            <input type="number" name="sessions_added" placeholder="عدد الحصص المضافة" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold focus:ring-2 focus:ring-green-500" />
            <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-black py-3 rounded-xl transition-all">تسجيل الدفعة</button>
          </form>
        </div>

        <!-- Link Teacher -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm relative overflow-hidden group hover:border-purple-300 transition-colors">
          <div class="absolute -right-4 -top-4 w-16 h-16 bg-purple-50 rounded-full flex items-center justify-center opacity-50 group-hover:scale-150 transition-transform">
            <Link2 class="w-6 h-6 text-purple-500" />
          </div>
          <h3 class="text-lg font-black text-slate-800 mb-4 relative z-10">ربط مع معلم جديد</h3>
          <form method="POST" action="/api/students/link-teacher" class="space-y-3 relative z-10 h-full flex flex-col justify-between">
            <input type="hidden" name="student_id" value={student.id} />
            <select name="teacher_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold focus:ring-2 focus:ring-purple-500 mb-3">
              <option value="">اختر المعلم...</option>
              {teachers.map((t: any) => (
                <option value={t.id}>{t.name} ({t.subject})</option>
              ))}
            </select>
            <button type="submit" class="w-full bg-purple-500 hover:bg-purple-600 text-white font-black py-3 rounded-xl transition-all mt-auto">ربط المعلم</button>
          </form>
        </div>
      </div>

      <!-- Assigned Teachers & Log Session -->
      <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
        <h3 class="text-xl font-black text-slate-800 mb-6 flex items-center gap-2"><CheckCircle2 class="w-6 h-6 text-blue-500" /> المعلمين المرتبطين وتخصيم الحصص</h3>
        
        {assignedTeachers.length === 0 ? (
          <p class="text-slate-400 font-bold text-center py-4">لم يتم ربط الطالب بأي معلم بعد.</p>
        ) : (
          <div class="space-y-4">
            {assignedTeachers.map((at: any) => (
              <div class="flex flex-col sm:flex-row justify-between items-center bg-slate-50 p-4 rounded-2xl border border-slate-100">
                <div>
                  <div class="font-black text-slate-800 text-lg">{at.name}</div>
                  <div class="text-sm font-bold text-slate-500">{at.subject} • سعر الحصة المخصص: <span class="text-indigo-600">{at.price || 'لم يحدد (افتراضي)'}</span></div>
                </div>
                <form method="POST" action="/api/students/log-session" class="mt-4 sm:mt-0 flex gap-2 w-full sm:w-auto">
                  <input type="hidden" name="student_id" value={student.id} />
                  <input type="hidden" name="teacher_id" value={at.teacher_id} />
                  <button type="submit" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-6 rounded-xl transition-all disabled:opacity-50" disabled={student.total_sessions <= 0}>
                    تسجيل حصة (-1 حصة)
                  </button>
                </form>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- History -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Sessions Log -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
          <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><CalendarDays class="w-5 h-5 text-indigo-500" /> سجل الحضور</h3>
          {sessions.length === 0 ? <p class="text-slate-400 font-bold text-sm">لا يوجد حصص مسجلة.</p> : (
            <div class="space-y-3">
              {sessions.map((s: any) => (
                <div class="flex justify-between items-center text-sm border-b border-slate-100 pb-2">
                  <div>
                    <span class="font-bold text-slate-800">{s.teacher_name}</span>
                    <div class="text-xs text-slate-500">{new Date(s.session_date).toLocaleDateString('ar-SA')}</div>
                  </div>
                  <span class="bg-green-100 text-green-700 px-2 py-1 rounded-lg font-bold text-xs">{s.status}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Payments Log -->
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
          <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><CreditCard class="w-5 h-5 text-emerald-500" /> سجل المدفوعات</h3>
          {payments.length === 0 ? <p class="text-slate-400 font-bold text-sm">لا يوجد مدفوعات مسجلة.</p> : (
            <div class="space-y-3">
              {payments.map((p: any) => (
                <div class="flex justify-between items-center text-sm border-b border-slate-100 pb-2">
                  <div>
                    <span class="font-black text-emerald-600">{p.amount} ريال</span>
                    <div class="text-xs text-slate-500">{new Date(p.payment_date).toLocaleDateString('ar-SA')}</div>
                  </div>
                  <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded-lg font-bold text-xs">+{p.sessions_added} حصص</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</DashboardLayout>
