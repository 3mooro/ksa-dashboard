---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';

let leads: any[] = [];
try {
  const db = env.DB;
  if (db) {
    const { results } = await db.prepare("SELECT * FROM leads ORDER BY created_at DESC").all();
    if (results) leads = results;
  }
} catch (e) {
  console.error(e);
}

const newLeads = leads.filter(l => l.status === 'جديد' || !l.status);
const contactedLeads = leads.filter(l => l.status === 'متابعة');
const enrolledLeads = leads.filter(l => l.status === 'مشترك');

const title = "إدارة العملاء (CRM)";
---

<DashboardLayout title={title}>
  <div class="mb-10 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-black text-slate-800">إدارة العملاء المحتملين (CRM)</h1>
      <p class="text-slate-500 font-bold mt-1">نظام تتبع طلبات التسجيل الواردة من اتصل بنا (Kanban)</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
    
    <!-- Column 1: New -->
    <div class="bg-slate-50 rounded-3xl p-4 border border-slate-200">
      <div class="flex items-center justify-between mb-4 px-2">
        <h3 class="font-black text-slate-700 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-blue-500"></span>
          طلبات جديدة
        </h3>
        <span class="bg-slate-200 text-slate-600 px-3 py-1 rounded-full text-xs font-bold">{newLeads.length}</span>
      </div>
      <div class="space-y-4">
        {newLeads.map(lead => (
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <h4 class="font-black text-slate-800 text-lg mb-1">{lead.customer_name}</h4>
            <p class="text-slate-500 text-sm font-bold mb-3" dir="ltr">{lead.phone}</p>
            <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-lg mb-4">{lead.course_requested}</span>
            <div class="flex gap-2">
              <form action="/api/leads/update-status" method="POST" class="flex-1">
                <input type="hidden" name="id" value={lead.id} />
                <input type="hidden" name="status" value="متابعة" />
                <button class="w-full bg-slate-900 text-white text-xs font-bold py-2 rounded-xl hover:bg-slate-800 transition-colors">تم التواصل</button>
              </form>
              <a href={`https://wa.me/${lead.phone}`} target="_blank" class="w-10 h-10 flex items-center justify-center bg-green-50 text-green-600 rounded-xl hover:bg-green-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Column 2: Contacted -->
    <div class="bg-slate-50 rounded-3xl p-4 border border-slate-200">
      <div class="flex items-center justify-between mb-4 px-2">
        <h3 class="font-black text-slate-700 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
          جاري المتابعة
        </h3>
        <span class="bg-slate-200 text-slate-600 px-3 py-1 rounded-full text-xs font-bold">{contactedLeads.length}</span>
      </div>
      <div class="space-y-4">
        {contactedLeads.map(lead => (
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-yellow-100 hover:shadow-md transition-shadow">
            <h4 class="font-black text-slate-800 text-lg mb-1">{lead.customer_name}</h4>
            <p class="text-slate-500 text-sm font-bold mb-3" dir="ltr">{lead.phone}</p>
            <div class="flex gap-2">
              <form action="/api/leads/update-status" method="POST" class="flex-1">
                <input type="hidden" name="id" value={lead.id} />
                <input type="hidden" name="status" value="مشترك" />
                <button class="w-full bg-yellow-400 text-yellow-900 text-xs font-bold py-2 rounded-xl hover:bg-yellow-500 transition-colors">تحويل إلى مشترك</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Column 3: Enrolled -->
    <div class="bg-slate-50 rounded-3xl p-4 border border-slate-200">
      <div class="flex items-center justify-between mb-4 px-2">
        <h3 class="font-black text-slate-700 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-green-500"></span>
          مشتركين (تم الدفع)
        </h3>
        <span class="bg-slate-200 text-slate-600 px-3 py-1 rounded-full text-xs font-bold">{enrolledLeads.length}</span>
      </div>
      <div class="space-y-4">
        {enrolledLeads.map(lead => (
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-green-100 opacity-75">
            <h4 class="font-black text-slate-800 text-lg mb-1">{lead.customer_name}</h4>
            <p class="text-slate-500 text-sm font-bold mb-3" dir="ltr">{lead.phone}</p>
            <span class="inline-flex items-center gap-1 text-green-600 text-xs font-bold bg-green-50 px-2 py-1 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              نجاح
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</DashboardLayout>
