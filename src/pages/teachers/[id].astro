---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { ArrowRight, User, DollarSign, CalendarDays } from 'lucide-astro';

const { id } = Astro.params;
const db = env.DB;
let teacher: any = null;
let transactions: any[] = [];
let prices: any[] = [];
let weeklySchedule: any[] = [];
let upcomingSessions: any[] = [];
let error = "";

if (db && id) {
  try {
    teacher = await db.prepare('SELECT * FROM teachers WHERE id = ?').bind(id).first();
    if (!teacher) {
      return Astro.redirect('/teachers');
    }

    const { results } = await db.prepare('SELECT * FROM teacher_transactions WHERE teacher_id = ? ORDER BY created_at DESC').bind(id).all();
    transactions = results || [];

    const pricesRes = await db.prepare('SELECT * FROM teacher_prices WHERE teacher_id = ?').bind(id).all();
    prices = pricesRes.results || [];

    try {
      const weeklyRes = await db.prepare(`
        SELECT ws.*, s.name as student_name
        FROM weekly_schedule ws
        JOIN students s ON s.id = ws.student_id
        WHERE ws.teacher_id = ?
      `).bind(id).all();
      weeklySchedule = weeklyRes.results || [];

      const upcomingRes = await db.prepare(`
        SELECT ss.*, s.name as student_name
        FROM session_schedule ss
        LEFT JOIN students s ON s.id = ss.student_id
        WHERE ss.teacher_id = ? AND IFNULL(ss.status, 'scheduled') = 'scheduled'
        ORDER BY ss.session_datetime ASC
      `).bind(id).all();
      upcomingSessions = upcomingRes.results || [];
    } catch(e2) {
      console.error(e2);
    }
  } catch(e) {
    console.error(e);
    error = "حدث خطأ أثناء جلب البيانات";
  }
}

// أوقات الجدول محفوظة بتوقيت السعودية (+03:00)، وتُعرض هنا بتوقيت مصر (Africa/Cairo)
const DAY_NAMES = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
const DAY_IDX: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
const cairoTimeFmt = new Intl.DateTimeFormat('ar-EG', { timeZone: 'Africa/Cairo', hour: 'numeric', minute: 'numeric', hour12: true });
const cairoDayFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Africa/Cairo', weekday: 'short' });
const cairoHMfmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const cairoDateFmt = new Intl.DateTimeFormat('ar-EG', { timeZone: 'Africa/Cairo', weekday: 'long', day: 'numeric', month: 'long' });

const weeklyRows = weeklySchedule.map((ws: any) => {
  // 2000-01-02 كان يوم أحد، فنبني التاريخ في أسبوع معروف ثم نحوّله لتوقيت القاهرة (معالجةً لانزياح اليوم)
  const dayNum = 2 + Number(ws.day_of_week || 0);
  const date = new Date(`2000-01-0${dayNum}T${ws.time_of_day}+03:00`);
  const cairoDay = DAY_IDX[cairoDayFmt.format(date)] ?? Number(ws.day_of_week || 0);
  const parts = cairoHMfmt.formatToParts(date);
  const hh = Number(parts.find(p => p.type === 'hour')?.value || 0);
  const mm = Number(parts.find(p => p.type === 'minute')?.value || 0);
  return { ...ws, cairoDay, cairoDayName: DAY_NAMES[cairoDay], cairoMinutes: hh * 60 + mm, cairoTime: cairoTimeFmt.format(date) };
}).sort((a: any, b: any) => a.cairoDay - b.cairoDay || a.cairoMinutes - b.cairoMinutes);

const nowTs = Date.now();
const upcomingRows = upcomingSessions.map((ss: any) => {
  const raw = String(ss.session_datetime || '').replace(' ', 'T');
  const date = new Date(raw.endsWith('Z') || raw.includes('+') ? raw : raw + '+03:00');
  return { ...ss, date };
}).filter((r: any) => !isNaN(r.date.getTime()) && r.date.getTime() >= nowTs - 60 * 60 * 1000)
  .slice(0, 20)
  .map((r: any) => ({ ...r, cairoDate: cairoDateFmt.format(r.date), cairoTime: cairoTimeFmt.format(r.date) }));
---

<DashboardLayout title={teacher ? `كشف حساب - ${teacher.name}` : 'كشف حساب'}>
  <div class="mb-6">
    <a href="/teachers" class="text-slate-500 hover:text-blue-600 flex items-center gap-2 font-bold mb-4 inline-flex">
      <ArrowRight class="w-4 h-4" /> العودة لقائمة المعلمين
    </a>
    {teacher && (
      <div class="flex items-center gap-4 bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <div class="p-4 bg-blue-50 text-blue-600 rounded-2xl">
          <User class="w-8 h-8" />
        </div>
        <div>
          <h2 class="text-3xl font-black text-slate-800">{teacher.name}</h2>
          <p class="text-slate-500 font-bold mt-1">السعر الأساسي للحصة: {teacher.session_price} ريال</p>
        </div>
      </div>
    )}
  </div>

  {teacher && (
    <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm mb-8">
      <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between flex-wrap gap-2">
        <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <CalendarDays class="w-5 h-5 text-indigo-500" /> جدول مواعيد المعلم
        </h3>
        <span class="bg-indigo-100 text-indigo-700 px-3 py-1 rounded-lg font-bold text-xs">جميع الأوقات بتوقيت مصر (القاهرة)</span>
      </div>

      <div class="p-6 border-b border-slate-100">
        <h4 class="text-base font-black text-slate-700 mb-3">الجدول الأسبوعي الثابت</h4>
        {weeklyRows.length === 0 ? (
          <p class="text-slate-400 text-sm font-bold">لا يوجد جدول أسبوعي ثابت مسجل لهذا المعلم.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-muted/50 text-muted-foreground border-b text-sm font-bold">
                  <th class="p-3">اليوم</th>
                  <th class="p-3">الطالب</th>
                  <th class="p-3">الموعد (بتوقيت مصر)</th>
                </tr>
              </thead>
              <tbody class="divide-y text-sm">
                {weeklyRows.map((ws: any) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="p-3 font-black text-indigo-700">{ws.cairoDayName}</td>
                    <td class="p-3 font-bold text-slate-700">{ws.student_name}</td>
                    <td class="p-3 font-bold text-slate-600">{ws.cairoTime}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <div class="p-6">
        <h4 class="text-base font-black text-slate-700 mb-3">الحصص المجدولة القادمة</h4>
        {upcomingRows.length === 0 ? (
          <p class="text-slate-400 text-sm font-bold">لا توجد حصص مجدولة قادمة لهذا المعلم.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-muted/50 text-muted-foreground border-b text-sm font-bold">
                  <th class="p-3">التاريخ</th>
                  <th class="p-3">الطالب</th>
                  <th class="p-3">الموعد (بتوقيت مصر)</th>
                </tr>
              </thead>
              <tbody class="divide-y text-sm">
                {upcomingRows.map((ss: any) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="p-3 font-black text-indigo-700">{ss.cairoDate}</td>
                    <td class="p-3 font-bold text-slate-700">{ss.student_name || '—'}</td>
                    <td class="p-3 font-bold text-slate-600">{ss.cairoTime}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    
    <div class="md:col-span-1 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm">
      <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2">
        <DollarSign class="w-5 h-5 text-green-500" /> تسعير مخصص للمراحل
      </h3>
      <form method="POST" action="/api/teachers/set-price" class="space-y-3 mb-6">
        <input type="hidden" name="teacher_id" value={teacher.id} />
        <select name="grade" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold focus:ring-2 focus:ring-green-500">
          <option value="الابتدائي">المرحلة الابتدائية</option>
          <option value="المتوسط">المرحلة المتوسطة</option>
          <option value="الثانوي">المرحلة الثانوية</option>
          <option value="القدرات والتحصيلي">قدرات وتحصيلي</option>
          <option value="الجامعي">المرحلة الجامعية</option>
        </select>
        <input type="number" name="price" placeholder="السعر المخصص (ريال)" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold focus:ring-2 focus:ring-green-500" />
        <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-black py-2.5 rounded-xl transition-all">إضافة تسعير</button>
      </form>

      <div class="space-y-2">
        {prices.length === 0 ? <p class="text-slate-400 text-sm font-bold">لا يوجد أسعار مخصصة.</p> : (
          prices.map(p => (
            <div class="flex justify-between items-center bg-slate-50 p-2 rounded-lg border border-slate-100 text-sm">
              <span class="font-bold text-slate-700">{p.grade}</span>
              <span class="font-black text-green-600">{p.price_per_session} ريال</span>
            </div>
          ))
        )}
      </div>
    </div>

    <div class="md:col-span-2 bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm h-fit">
      <div class="p-6 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-xl font-bold text-slate-800">سجل العمليات</h3>
      </div>
      <div class="overflow-x-auto max-h-[500px]">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-muted/50 text-muted-foreground border-b text-sm font-bold">
              <th class="p-4">التاريخ</th>
              <th class="p-4">نوع العملية</th>
              <th class="p-4">الحصص (التغير)</th>
              <th class="p-4">البيان / الملاحظات</th>
            </tr>
          </thead>
          <tbody class="divide-y text-sm">
            {transactions.map(txn => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-4 font-bold text-slate-600" dir="ltr">{new Date(txn.created_at).toLocaleString('ar-SA')}</td>
                <td class="p-4">
                  {txn.change_type === 'payout' ? (
                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-lg font-bold text-xs">دفع وتصفير</span>
                  ) : (
                    <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg font-bold text-xs">تسجيل حصة</span>
                  )}
                </td>
                <td class="p-4 font-black">
                  <span class={txn.amount > 0 ? "text-blue-600" : "text-red-600"} dir="ltr">
                    {txn.amount > 0 ? `+${txn.amount}` : txn.amount}
                  </span>
                </td>
                <td class="p-4 text-slate-700 font-bold">{txn.note}</td>
              </tr>
            ))}
            {transactions.length === 0 && (
              <tr>
                <td colspan="4" class="p-8 text-center text-slate-400 font-bold">لا توجد عمليات مسجلة حتى الآن</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>
