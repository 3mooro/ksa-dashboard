---
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { Plus, Edit2, Trash2, Calculator, UserPlus } from 'lucide-astro';
import { env } from 'cloudflare:workers';

let teachers = [];
let pendingTeachers = [];
let error = "";
let success = Astro.url.searchParams.get('success');

try {
	const db = env.DB;
	const { results } = await db.prepare("SELECT * FROM teachers WHERE status = 'active' ORDER BY created_at DESC").all();
	if (results) teachers = results;
	const pendingRes = await db.prepare("SELECT * FROM teachers WHERE status = 'pending' ORDER BY created_at ASC").all();
	if (pendingRes.results) pendingTeachers = pendingRes.results;
} catch (e) {
	console.error(e);
	error = "حدث خطأ أثناء جلب بيانات المعلمين.";
}
---

<DashboardLayout title="إدارة المعلمين">
	<div class="flex justify-between items-center mb-8">
		<div>
			<h2 class="text-3xl font-black text-slate-800">إدارة المعلمين</h2>
			<p class="text-slate-500 font-bold mt-1">أضف المعلمين، حدد سعر الحصة، واحسب مستحقاتهم المالية.</p>
		</div>
		<button onclick="document.getElementById('add-teacher-modal').classList.remove('hidden')" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl font-bold transition-all shadow-md shadow-blue-600/20 hover:-translate-y-0.5">
			<UserPlus class="w-5 h-5" /> إضافة معلم جديد
		</button>
	</div>

	{error && <div class="bg-red-50 text-red-700 px-6 py-4 rounded-2xl mb-8 font-bold border border-red-200">{error}</div>}
	{success === 'added' && <div class="bg-green-50 text-green-700 px-6 py-4 rounded-2xl mb-8 font-bold border border-green-200">تم إضافة المعلم بنجاح!</div>}
	{success === 'updated' && <div class="bg-green-50 text-green-700 px-6 py-4 rounded-2xl mb-8 font-bold border border-green-200">تم تسجيل الحصة بنجاح!</div>}
	{success === 'approved' && <div class="bg-green-50 text-green-700 px-6 py-4 rounded-2xl mb-8 font-bold border border-green-200">تم تفعيل حساب المعلم وتحديد سعر الحصة!</div>}

	{pendingTeachers.length > 0 && (
		<div class="mb-10">
			<h3 class="text-xl font-black text-slate-800 mb-4 border-b-2 border-yellow-400 inline-block pb-2">طلبات انضمام معلمين جديدة</h3>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{pendingTeachers.map((t: any) => (
					<div class="bg-yellow-50 rounded-3xl p-6 shadow-sm border border-yellow-200 flex flex-col">
						<div class="flex justify-between items-start mb-4">
							<div>
								<h3 class="text-xl font-black text-slate-800">{t.name}</h3>
								<span class="text-sm font-bold text-slate-500 bg-white px-3 py-1 rounded-full mt-2 inline-block border border-yellow-200">{t.subject}</span>
							</div>
							<form method="POST" action="/api/teachers/delete" onsubmit="return confirm('هل أنت متأكد من رفض وحذف هذا الطلب؟');">
								<input type="hidden" name="id" value={t.id} />
								<button type="submit" class="text-red-400 hover:text-red-600 bg-white p-2 rounded-lg transition-colors border border-red-100" title="رفض الطلب">
									<Trash2 class="w-4 h-4" />
								</button>
							</form>
						</div>
						<p class="font-bold text-sm text-slate-600 mb-4" dir="ltr">{t.phone}</p>
						<form method="POST" action="/api/teachers/approve" class="mt-auto flex flex-col gap-2">
							<input type="hidden" name="id" value={t.id} />
							<input type="number" name="session_price" placeholder="سعر الحصة (ريال)" required class="w-full bg-white border border-yellow-300 rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-yellow-500 text-left" dir="ltr" />
							<button type="submit" class="w-full bg-yellow-400 hover:bg-yellow-500 text-yellow-900 font-bold py-3 rounded-xl transition-all shadow-sm">
								تفعيل الحساب
							</button>
						</form>
					</div>
				))}
			</div>
		</div>
	)}

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{teachers.length === 0 ? (
			<div class="col-span-full bg-white rounded-3xl p-12 text-center border border-slate-100 shadow-sm">
				<p class="text-slate-400 font-bold text-lg mb-4">لا يوجد معلمين مسجلين حالياً.</p>
				<button onclick="document.getElementById('add-teacher-modal').classList.remove('hidden')" class="text-blue-600 hover:text-blue-700 font-bold">أضف معلمك الأول</button>
			</div>
		) : (
			teachers.map((teacher: any) => (
				<div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 flex flex-col hover:shadow-md transition-shadow">
					<div class="flex justify-between items-start mb-4">
						<div>
							<h3 class="text-xl font-black text-slate-800">{teacher.name}</h3>
							<span class="text-sm font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full mt-2 inline-block">{teacher.subject}</span>
						</div>
						<div class="flex gap-2">
							<form method="POST" action="/api/teachers/delete" onsubmit="return confirm('هل أنت متأكد من حذف هذا المعلم؟');">
								<input type="hidden" name="id" value={teacher.id} />
								<button type="submit" class="text-red-400 hover:text-red-600 bg-red-50 hover:bg-red-100 p-2 rounded-lg transition-colors" title="حذف المعلم">
									<Trash2 class="w-4 h-4" />
								</button>
							</form>
						</div>
					</div>

					<div class="flex-1 space-y-4 my-6 bg-slate-50 rounded-2xl p-4 border border-slate-100">
						<div class="flex justify-between items-center border-b border-slate-200 pb-2">
							<span class="text-sm font-bold text-slate-600">سعر الحصة:</span>
							<span class="font-black text-slate-800">{teacher.session_price} ريال</span>
						</div>
						<div class="flex justify-between items-center border-b border-slate-200 pb-2">
							<span class="text-sm font-bold text-slate-600">عدد الحصص:</span>
							<span class="font-black text-blue-600 bg-blue-100 px-3 py-1 rounded-lg">{teacher.sessions_completed} حصة</span>
						</div>
						<div class="flex justify-between items-center pt-2">
							<span class="text-sm font-bold text-slate-600">المستحقات الإجمالية:</span>
							<span class="font-black text-green-600 text-lg">{teacher.session_price * teacher.sessions_completed} ريال</span>
						</div>
					</div>

					<div class="flex flex-col gap-2 mt-auto">
						<form method="POST" action="/api/teachers/add-session">
							<input type="hidden" name="id" value={teacher.id} />
							<button type="submit" class="w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-xl font-bold transition-all hover:scale-[1.02]">
								<Plus class="w-4 h-4" /> تسجيل حصة يدوية (+1)
							</button>
						</form>
						<form method="POST" action="/api/teachers/pay" onsubmit="return confirm('هل أنت متأكد من دفع المستحقات وتصفير العداد؟');">
							<input type="hidden" name="id" value={teacher.id} />
							<button type="submit" class="w-full flex items-center justify-center gap-2 bg-green-100 hover:bg-green-200 text-green-800 py-3 rounded-xl font-bold transition-all" disabled={teacher.sessions_completed === 0}>
								<Calculator class="w-4 h-4" /> دفع المستحقات وتصفير العداد
							</button>
						</form>
						<a href={`/teachers/${teacher.id}`} class="w-full flex items-center justify-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 py-2 rounded-xl font-bold transition-all mt-1">
							عرض كشف الحساب
						</a>
					</div>
				</div>
			))
		)}
	</div>

	<!-- Add Teacher Modal -->
	<div id="add-teacher-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center flex">
		<div class="bg-white p-8 rounded-3xl w-full max-w-md shadow-2xl relative border border-slate-100">
			<button type="button" onclick="document.getElementById('add-teacher-modal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
			</button>
			<h3 class="text-2xl font-black mb-6 text-slate-800">إضافة معلم جديد</h3>
			
			<form method="POST" action="/api/teachers/save" class="space-y-4">
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">اسم المعلم</label>
					<input type="text" name="name" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold" />
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">رابط صورة المعلم (URL)</label>
					<input type="text" name="image" placeholder="https://..." class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold text-left" dir="ltr" />
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">المادة (التخصص)</label>
					<input type="text" name="subject" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold" />
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">الخبرة</label>
					<input type="text" name="experience" placeholder="مثال: خبرة 10 سنوات..." class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold" />
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">نبذة تعريفية</label>
					<textarea name="bio" rows="2" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold"></textarea>
				</div>
				<div>
					<label class="block text-sm font-bold text-slate-700 mb-2">سعر الحصة (ريال)</label>
					<input type="number" name="session_price" value="0" min="0" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-bold text-left" dir="ltr" />
				</div>
				<button type="submit" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-black transition-all shadow-lg shadow-blue-600/30">
					حفظ المعلم
				</button>
			</form>
		</div>
	</div>
</DashboardLayout>